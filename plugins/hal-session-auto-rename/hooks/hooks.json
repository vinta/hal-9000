{
  "description": "Automatically name each session, and optionally re-name it as the conversation drifts",
  "hooks": {
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python3 ${CLAUDE_PLUGIN_ROOT}/scripts/hal-session-auto-rename.py",
            "timeout": 5
          }
        ]
      }
    ]
  }
}
