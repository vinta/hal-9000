{
  "name": "hal-grammar-check",
  "displayName": "HAL Grammar Check",
  "version": "0.3.4",
  "description": "Grammar-check your prompt as you type, shown above the prompt box",
  "author": {
    "name": "Vinta Chen",
    "email": "vinta.chen@gmail.com"
  },
  "repository": "https://github.com/vinta/hal-9000",
  "homepage": "https://vinta.ws/code/",
  "documentationUrl": "https://github.com/vinta/hal-9000/blob/main/plugins/hal-grammar-check/README.md",
  "supportUrl": "https://github.com/vinta/hal-9000/issues",
  "license": "MIT",
  "icon": "./icon.png",
  "keywords": [
    "grammar",
    "grammar-check",
    "spelling",
    "spell-check",
    "hooks",
    "mods",
    "ollama",
    "english",
    "chinese",
    "traditional-chinese",
    "simplified-chinese",
    "japanese",
    "korean"
  ],
  "types": "./types/index.d.ts",
  "userConfig": {
    "model": {
      "type": "string",
      "title": "Model",
      "description": "claude/haiku runs on your Claude account; ollama/gemma4:31b-mlx runs on a local Ollama at localhost:11434.",
      "options": ["claude/haiku", "ollama/gemma4:31b-mlx"],
      "default": "claude/haiku"
    },
    "language": {
      "type": "string",
      "title": "Language",
      "description": "The language the grammar check writes its explanations in.",
      "options": ["English", "Traditional Chinese", "Simplified Chinese", "Japanese", "Korean"],
      "default": "English"
    }
  }
}
