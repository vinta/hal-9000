{
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "^apply_patch$",
        "hooks": [
          {
            "type": "command",
            "command": "/bin/bash \"$(git rev-parse --show-toplevel)/.codex/hooks/sync-dotfiles.sh\"",
            "timeout": 30,
            "statusMessage": "Syncing dotfiles..."
          }
        ]
      }
    ]
  }
}
