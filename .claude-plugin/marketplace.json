    {
      "name": "hal-output-styles",
      "displayName": "HAL Output Styles",
      "description": "Make Claude Code talk like an INTJ",
      "source": "./plugins/hal-output-styles",
      "author": {
        "name": "Vinta Chen",
        "email": "vinta.chen@gmail.com"
      },
      "repository": "https://github.com/vinta/hal-9000",
      "homepage": "https://vinta.ws/code/",
      "license": "MIT",
      "category": "productivity",
      "keywords": [
        "output-style",
        "telegraphic",
        "concise",
        "simplified-technical-english",
        "asd-ste100",
        "intj"
      ],
      "tags": [
        "output-style",
        "telegraphic",
        "concise",
        "simplified-technical-english",
        "asd-ste100",
        "intj"
      ]
    },
    {
      "name": "hal-grammar-check",
      "displayName": "HAL Grammar Check",
      "description": "Grammar-check your prompt as you type, shown above the prompt box",
      "source": "./plugins/hal-grammar-check",
      "author": {
        "name": "Vinta Chen",
        "email": "vinta.chen@gmail.com"
      },
      "repository": "https://github.com/vinta/hal-9000",
      "homepage": "https://vinta.ws/code/",
      "license": "MIT",
      "types": "./types/index.d.ts",
      "category": "productivity",
      "keywords": [
        "grammar",
        "grammar-check",
        "spelling",
        "spell-check",
        "hooks",
        "mods",
        "ollama",
        "english",
        "chinese",
        "traditional-chinese",
        "simplified-chinese",
        "japanese",
        "korean"
      ],
      "tags": [
        "grammar",
        "grammar-check",
        "spelling",
        "spell-check",
        "hooks",
        "mods",
        "ollama",
        "english",
        "chinese",
        "traditional-chinese",
        "simplified-chinese",
        "japanese",
        "korean"
      ],
      "userConfig": {
        "model": {
          "type": "string",
          "title": "Model",
          "description": "claude/haiku runs on your Claude account; ollama/gemma4:26b-nvfp4 runs on a local Ollama at localhost:11434.",
          "options": [
            "claude/haiku",
            "ollama/gemma4:26b-nvfp4"
          ],
          "default": "claude/haiku"
        },
        "language": {
          "type": "string",
          "title": "Language",
          "description": "The language the grammar check writes its explanations in.",
          "options": [
            "English",
            "Traditional Chinese",
            "Simplified Chinese",
            "Japanese",
            "Korean"
          ],
          "default": "English"
        }
      }
    },
    {
      "name": "hal-session-auto-rename",
      "displayName": "HAL Session Auto-rename",
      "description": "Automatically name each session and rename it as the conversation evolves",
      "source": "./plugins/hal-session-auto-rename",
      "author": {
        "name": "Vinta Chen",
        "email": "vinta.chen@gmail.com"
      },
      "repository": "https://github.com/vinta/hal-9000",
      "homepage": "https://vinta.ws/code/",
      "license": "MIT",
      "category": "productivity",
      "keywords": [
        "session",
        "session-title",
        "auto-rename",
        "title",
        "ai-title",
        "hooks",
        "mods",
        "ollama"
      ],
      "tags": [
        "session",
        "session-title",
        "auto-rename",
        "title",
        "ai-title",
        "hooks",
        "mods",
        "ollama"
      ],
      "userConfig": {
        "model": {
          "type": "string",
          "title": "Model",
          "description": "claude/haiku runs on your Claude account; ollama/gemma4:26b-nvfp4 runs on a local Ollama at localhost:11434.",
          "options": [
            "claude/haiku",
            "ollama/gemma4:26b-nvfp4"
          ],
          "default": "claude/haiku"
        },
        "refreshEveryNTurns": {
          "type": "number",
          "title": "Refresh every N turns",
          "description": "Regenerate the session title every N turns. 0 keeps the first title.",
          "default": 5
        }
      }
    },
    {
      "name": "hal-shell-mode-auto-suggest",
      "displayName": "HAL Shell Mode Auto-suggest",
      "description": "Suggests the `!` shell command Claude's last reply asks you to run, Tab to take",
      "source": "./plugins/hal-shell-mode-auto-suggest",
      "author": {
        "name": "Vinta Chen",
        "email": "vinta.chen@gmail.com"
      },
      "repository": "https://github.com/vinta/hal-9000",
      "homepage": "https://vinta.ws/code/",
      "license": "MIT",
      "category": "productivity",
      "keywords": [
        "shell",
        "shell-mode",
        "bash",
        "prompt-suggestion",
        "auto-suggest",
        "hooks",
        "mods"
      ],
      "tags": [
        "shell",
        "shell-mode",
        "bash",
        "prompt-suggestion",
        "auto-suggest",
        "hooks",
        "mods"
      ]
    },
    {
      "name": "hal-voice",
      "displayName": "HAL Voice",
      "description": "Play HAL 9000 voice clips on Claude Code hook events",
      "source": "./plugins/hal-voice",
      "author": {
        "name": "Vinta Chen",
        "email": "vinta.chen@gmail.com"
      },
      "repository": "https://github.com/vinta/hal-9000",
      "homepage": "https://vinta.ws/code/",
      "license": "MIT",
      "category": "entertainment",
      "keywords": [
        "hal-9000",
        "voice",
        "audio",
        "hooks"
      ],
      "tags": [
        "hal-9000",
        "voice",
        "audio",
        "hooks"
      ],
      "userConfig": {
        "play_in_terminal": {
          "type": "boolean",
          "title": "Play in terminal",
          "description": "Play clips in the terminal CLI",
          "default": true
        },
        "play_in_desktop_app": {
          "type": "boolean",
          "title": "Play in desktop app",
          "description": "Play clips in the Claude desktop app",
          "default": false
        },
        "play_in_vscode": {
          "type": "boolean",
          "title": "Play in VS Code",
          "description": "Play clips in the VS Code extension",
          "default": false
        },
        "volume": {
          "type": "number",
          "title": "Volume",
          "description": "Playback volume, from 0 to 100",
          "default": 50,
          "min": 0,
          "max": 100
        }
      }
    }
  ]
}
