{
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "Write|Edit",
        "hooks": [
          {
            "type": "command",
            "command": "bash .claude/hooks/sync-dotfiles.sh 2>/dev/null || true",
            "if": "Edit(/dotfiles/**)",
            "async": true,
            "timeout": 30,
            "statusMessage": "Syncing dotfiles..."
          },
          {
            "type": "command",
            "command": "bash .claude/hooks/lint-on-edit.sh lint-python",
            "if": "Edit(**/*.py)",
            "timeout": 30,
            "statusMessage": "Linting Python code..."
          },
          {
            "type": "command",
            "command": "bash .claude/hooks/lint-on-edit.sh lint-ansible",
            "if": "Edit(/playbooks/**)",
            "timeout": 30,
            "statusMessage": "Linting Ansible playbooks..."
          }
        ]
      }
    ]
  }
}
