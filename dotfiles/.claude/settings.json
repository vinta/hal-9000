{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "cleanupPeriodDays": 999999,
  "env": {
    "CLAUDE_CODE_DISABLE_FEEDBACK_SURVEY": "1",
    "CLAUDE_CODE_EXPERIMENTAL_AGENT_TEAMS": "1",
    "CLAUDE_CODE_RETRY_WATCHDOG": "1",
    "DISABLE_ERROR_REPORTING": "1",
    "DISABLE_EXTRA_USAGE_COMMAND": "1",
    "DISABLE_FEEDBACK_COMMAND": "1",
    "DISABLE_UPGRADE_COMMAND": "1",
    "HAL_SESSION_AUTO_RENAME_USE_OLLAMA": "1",
    "HAL_STATUSLINE_GRAMMAR_CHECK_USE_OLLAMA": "1"
  },
  "includeGitInstructions": false,
  "permissions": {
    "allow": [
      "Read(~/Projects/**)",
      "Edit(~/Projects/**)",
      "Bash(git status *)",
      "Bash(git diff *)",
      "Bash(git branch *)",
      "Bash(git log *)",
      "Bash(git stash *)",
      "Bash(git add *)",
      "Bash(git mv *)",
      "Bash(git rm *)",
      "Bash(git apply *)",
      "Bash(git commit *)",
      "Bash(git restore *)",
      "Bash(git show *)",
      "Bash(git rev-parse *)",
      "Bash(gh repo view *)",
      "Bash(ls *)",
      "Bash(tree *)",
      "Bash(grep *)",
      "Bash(find *)",
      "Bash(pwd *)",
      "Bash(which *)",
      "Bash(mkdir *)",
      "WebSearch"
    ],
    "deny": [
      "Read(~/.aws/**)",
      "Read(~/.config/**)",
      "Read(~/.docker/**)",
      "Read(~/.dropbox/**)",
      "Read(~/.gnupg/**)",
      "Read(~/.gsutil/**)",
      "Read(~/.kube/**)",
      "Read(~/.npmrc)",
      "Read(~/.orbstack/**)",
      "Read(~/.pypirc)",
      "Read(~/.ssh/**)",
      "Read(~/*_history)",
      "Read(~/**/*credential*)",
      "Read(~/Library/**)",
      "Edit(~/Library/**)",
      "Read(~/Dropbox/**)",
      "Edit(~/Dropbox/**)",
      "Read(//etc/**)",
      "Edit(//etc/**)",
      "Bash(git -c *)",
      "Bash(git --config-env*)",
      "Bash(git --git-dir*)",
      "Bash(gh repo delete *)",
      "Bash(su *)",
      "Bash(sudo *)",
      "Bash(passwd *)",
      "Bash(env *)",
      "Bash(printenv *)",
      "Bash(history *)",
      "Bash(fc *)",
      "Bash(eval *)",
      "Bash(exec *)",
      "Bash(rsync *)",
      "Bash(sftp *)",
      "Bash(telnet *)",
      "Bash(socat *)",
      "Bash(nc *)",
      "Bash(ncat *)",
      "Bash(netcat *)",
      "Bash(nmap *)",
      "Bash(chflags *)",
      "Bash(xattr *)",
      "Bash(diskutil *)",
      "Bash(mkfs *)",
      "Bash(security *)",
      "Bash(defaults *)",
      "Bash(launchctl *)",
      "Bash(osascript *)",
      "Bash(dscl *)",
      "Bash(networksetup *)",
      "Bash(scutil *)",
      "Bash(systemsetup *)",
      "Bash(pmset *)",
      "Bash(crontab *)"
    ],
    "ask": [
      "Bash(open *)",
      "Bash(chmod *)",
      "Bash(chown *)",
      "Bash(kill *)",
      "Bash(killall *)",
      "Bash(pkill *)",
      "Bash(curl *-d *)",
      "Bash(curl *--data*)",
      "Bash(curl *--json *)",
      "Bash(curl *-F *)",
      "Bash(curl *--form *)",
      "Bash(curl *-T *)",
      "Bash(curl *--upload-file *)",
      "Bash(curl *-H *)",
      "Bash(curl *--header *)",
      "Bash(brew install *)",
      "Bash(pip install *)",
      "Bash(uv pip install *)",
      "Bash(uv tool install *)",
      "Bash(uv add *)",
      "Bash(npm install *)",
      "Bash(npm i *)",
      "Bash(yarn add *)",
      "Bash(pnpm add *)",
      "Bash(bun add *)",
      "Bash(git push *)",
      "Bash(git remote add *)",
      "Bash(git remote set-url *)",
      "Bash(git config remote.*)",
      "Bash(git config * remote.*)",
      "Bash(gh repo create *)",
      "Bash(gh repo rename *)",
      "Bash(gh *--admin*)",
      "Bash(gh api *-X *)",
      "Bash(gh api *--method *)"
    ],
    "defaultMode": "auto"
  },
  "model": "opus[1m]",
  "disableClaudeAiConnectors": true,
  "skillOverrides": {
    "claude-api": "off",
    "code-review": "off",
    "fewer-permission-prompts": "off",
    "keybindings-help": "off"
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "python3 ~/.claude/hooks/guard-bash-paths.py"
          },
          {
            "type": "command",
            "command": "python3 ~/.claude/hooks/guard-network-egress.py"
          }
        ]
      }
    ]
  },
  "disableArtifact": true,
  "statusLine": {
    "type": "command",
    "command": "python3 ~/.claude/statusline/hal-statusline.py",
    "refreshInterval": 1
  },
  "enabledPlugins": {
    "codex@openai-codex": true,
    "mattpocock-skills@mattpocock": true,
    "hal-skills@hal-9000": true,
    "hal-session-auto-rename@hal-9000": true,
    "hal-voice@hal-9000": true
  },
  "extraKnownMarketplaces": {
    "openai-codex": {
      "source": {
        "source": "github",
        "repo": "openai/codex-plugin-cc"
      },
      "autoUpdate": true
    },
    "mattpocock": {
      "source": {
        "source": "github",
        "repo": "mattpocock/skills"
      },
      "autoUpdate": true
    },
    "hal-9000": {
      "source": {
        "source": "github",
        "repo": "vinta/hal-9000"
      },
      "autoUpdate": true
    }
  },
  "outputStyle": "Caveman",
  "viewMode": "verbose",
  "effortLevel": "high",
  "advisorModel": "fable",
  "awaySummaryEnabled": false,
  "showClearContextOnPlanAccept": true,
  "voice": {
    "enabled": true
  },
  "showThinkingSummaries": true,
  "skipWorkflowUsageWarning": true,
  "verbose": true,
  "switchModelsOnFlag": false,
  "teammateMode": "auto",
  "remoteControlAtStartup": false,
  "inputNeededNotifEnabled": true,
  "agentPushNotifEnabled": false,
  "skipAutoPermissionPrompt": true
}
