{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "cleanupPeriodDays": 999999,
  "syncClaudeAiSkills": false,
  "env": {
    "CLAUDE_CODE_DISABLE_FEEDBACK_SURVEY": "1",
    "CLAUDE_CODE_SUBAGENT_MODEL": "opus",
    "DISABLE_ERROR_REPORTING": "1",
    "DISABLE_EXTRA_USAGE_COMMAND": "1",
    "DISABLE_FEEDBACK_COMMAND": "1",
    "DISABLE_UPGRADE_COMMAND": "1",
    "HAL_STATUSLINE_GRAMMAR_CHECK_DISABLED": "1"
  },
  "attribution": {
    "commit": "Co-Authored-By: Claude <noreply@anthropic.com>",
    "sessionUrl": false
  },
  "includeGitInstructions": false,
  "permissions": {
    "allow": [
      "Bash(git branch *)",
      "Bash(git stash *)",
      "Bash(git add *)",
      "Bash(git mv *)",
      "Bash(git rm *)",
      "Bash(git apply *)",
      "Bash(git commit *)",
      "Bash(git restore *)",
      "Bash(gh repo view *)",
      "Bash(find *)",
      "Bash(mkdir *)",
      "WebSearch"
    ],
    "deny": [
      "Bash(git -c *)",
      "Bash(git --config-env*)",
      "Bash(git --git-dir*)",
      "Bash(git remote add *)",
      "Bash(git remote set-url *)",
      "Bash(git config remote.*)",
      "Bash(git config * remote.*)",
      "Bash(gh repo delete *)",
      "Bash(su *)",
      "Bash(sudo *)",
      "Bash(passwd *)",
      "Bash(env *)",
      "Bash(printenv *)",
      "Bash(history *)",
      "Bash(fc *)",
      "Bash(eval *)",
      "Bash(exec *)",
      "Bash(rsync *)",
      "Bash(sftp *)",
      "Bash(telnet *)",
      "Bash(socat *)",
      "Bash(nc *)",
      "Bash(ncat *)",
      "Bash(netcat *)",
      "Bash(nmap *)",
      "Bash(chflags *)",
      "Bash(xattr *)",
      "Bash(diskutil *)",
      "Bash(mkfs *)",
      "Bash(security *)",
      "Bash(defaults *)",
      "Bash(launchctl *)",
      "Bash(osascript *)",
      "Bash(dscl *)",
      "Bash(networksetup *)",
      "Bash(scutil *)",
      "Bash(systemsetup *)",
      "Bash(pmset *)",
      "Bash(crontab *)"
    ],
    "defaultMode": "auto"
  },
  "model": "opus[1m]",
  "disableClaudeAiConnectors": true,
  "skillOverrides": {
    "code-review": "off",
    "fewer-permission-prompts": "off",
    "keybindings-help": "off",
    "team-onboarding": "off"
  },
  "enableArtifact": true,
  "workflowSizeGuideline": "small",
  "statusLine": {
    "type": "command",
    "command": "python3 ~/.claude-blackwall/statusline/hal-statusline.py"
  },
  "subagentStatusLine": {
    "type": "command",
    "command": "python3 ~/.claude-blackwall/statusline/hal-statusline.py --subagents"
  },
  "enabledPlugins": {
    "cc-plugin-you-should-know@builtin": true,
    "hal-skills@hal-9000": true,
    "hal-output-styles@hal-9000": true,
    "hal-session-auto-rename@hal-9000": true,
    "hal-voice@hal-9000": true,
    "mattpocock-skills@mattpocock": true,
    "design@synced": false
  },
  "extraKnownMarketplaces": {
    "hal-9000": {
      "source": {
        "source": "github",
        "repo": "vinta/hal-9000"
      },
      "autoUpdate": false
    },
    "mattpocock": {
      "source": {
        "source": "github",
        "repo": "mattpocock/skills"
      },
      "autoUpdate": false
    }
  },
  "outputStyle": "hal-output-styles:Say no more",
  "viewMode": "verbose",
  "modelSettings": {
    "claude-fable-5-1": {
      "effortLevel": "high"
    },
    "claude-opus-5-5": {
      "effortLevel": "high"
    },
    "claude-sonnet-5-5": {
      "effortLevel": "high"
    }
  },
  "advisorModel": "fable",
  "awaySummaryEnabled": false,
  "showClearContextOnPlanAccept": true,
  "voice": {
    "enabled": true
  },
  "showThinkingSummaries": true,
  "skipWorkflowUsageWarning": true,
  "theme": "custom:sandbox",
  "switchModelsOnFlag": false,
  "teammateMode": "auto",
  "remoteControlAtStartup": false,
  "isolatePeerMachines": true,
  "inputNeededNotifEnabled": true,
  "agentPushNotifEnabled": false,
  "skipAutoPermissionPrompt": true,
  "skipDangerousModePermissionPrompt": true
}
