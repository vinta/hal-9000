# https://learn.chatgpt.com/docs/agent-configuration/rules

prefix_rule(pattern=["open"], decision="prompt")
prefix_rule(pattern=["kill"], decision="prompt")
prefix_rule(pattern=["killall"], decision="prompt")
prefix_rule(pattern=["pkill"], decision="prompt")
prefix_rule(pattern=["curl"], decision="prompt")
prefix_rule(pattern=["git", "filter-repo"], decision="prompt")
prefix_rule(pattern=["git", "push"], decision="prompt")
prefix_rule(pattern=["gh", "repo", "create"], decision="prompt")
prefix_rule(pattern=["gh", "repo", "rename"], decision="prompt")
prefix_rule(pattern=["brew", "install"], decision="prompt")
prefix_rule(pattern=["pip", "install"], decision="prompt")
prefix_rule(pattern=["uv", "pip", "install"], decision="prompt")
prefix_rule(pattern=["uv", "tool", "install"], decision="prompt")
prefix_rule(pattern=["uv", "add"], decision="prompt")
prefix_rule(pattern=["npm", "install"], decision="prompt")
prefix_rule(pattern=["npm", "i"], decision="prompt")
prefix_rule(pattern=["yarn", "add"], decision="prompt")
prefix_rule(pattern=["pnpm", "add"], decision="prompt")
prefix_rule(pattern=["bun", "add"], decision="prompt")

prefix_rule(pattern=["git", "-c"], decision="forbidden")
prefix_rule(pattern=["git", "--config-env"], decision="forbidden")
prefix_rule(pattern=["git", "--git-dir"], decision="forbidden")
prefix_rule(pattern=["git", "remote", "add"], decision="forbidden")
prefix_rule(pattern=["git", "remote", "set-url"], decision="forbidden")
prefix_rule(pattern=["gh", "repo", "delete"], decision="forbidden")
prefix_rule(pattern=["su"], decision="forbidden")
prefix_rule(pattern=["sudo"], decision="forbidden")
prefix_rule(pattern=["passwd"], decision="forbidden")
prefix_rule(pattern=["env"], decision="forbidden")
prefix_rule(pattern=["printenv"], decision="forbidden")
prefix_rule(pattern=["history"], decision="forbidden")
prefix_rule(pattern=["fc"], decision="forbidden")
prefix_rule(pattern=["eval"], decision="forbidden")
prefix_rule(pattern=["exec"], decision="forbidden")
prefix_rule(pattern=["rsync"], decision="forbidden")
prefix_rule(pattern=["sftp"], decision="forbidden")
prefix_rule(pattern=["telnet"], decision="forbidden")
prefix_rule(pattern=["socat"], decision="forbidden")
prefix_rule(pattern=["nc"], decision="forbidden")
prefix_rule(pattern=["ncat"], decision="forbidden")
prefix_rule(pattern=["netcat"], decision="forbidden")
prefix_rule(pattern=["nmap"], decision="forbidden")
prefix_rule(pattern=["chflags"], decision="forbidden")
prefix_rule(pattern=["xattr"], decision="forbidden")
prefix_rule(pattern=["diskutil"], decision="forbidden")
prefix_rule(pattern=["mkfs"], decision="forbidden")
prefix_rule(pattern=["security"], decision="forbidden")
prefix_rule(pattern=["defaults"], decision="forbidden")
